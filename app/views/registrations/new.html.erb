<div class="myrow">
	<style>
	 .table>tbody>tr>td, .table>tbody>tr>th, .table>tfoot>tr>td, .table>tfoot>tr>th, .table>thead>tr>td, .table>thead>tr>th {border:none;}
	</style>
<div class="col-d-12 col-t-12">
<%= render 'layouts/student_layout/card' %>
<div class="col-d-9 col-t-9">
            <div class="dashboard" style="padding-left: 30px;">
                <h3 class="dashboad-header">Course Registration</h3><hr/>
                <div  class="">
                    <% if !@registered.empty? %>
						<h4 class="centered">You've already registered for this session</h4>
					<% else %>
						<form name="course-registration-form" method="get" action="/create" style="width:100%">
							<label class="name-tag bold">Session:&nbsp</label><label><%= Util.where("name = ?", "session").first.value %></label><br/>
							<label class="name-tag bold">Year Of Study:&nbsp</label><label><%= current_student.level %> Level</label>
							
							<div class="table-responsive">
							<table class="table table-striped" style="margin-top:20px">
								<tr>
									<td colspan="6" class="semester" id="first-semester">FIRST SEMESTER</td>
								</tr>
								<tr>
									<th class="s">S/N</th><th >Course Code</th><th>Course Title</th><th>Course Status</th><th>Unit</th><th class=""></th>
								</tr>
								<% if !@fscc.nil? %>
									<% @fscc.each do|course| %>
								<tr class="reg-dta">
								   <td><%= @counter %></td><td><%= course.ccode %></td><td><%= course.ctitle %></td><td>C</td><td><%= course.units %></td><td><input type="hidden" onclick="validateEnrollment($('.first_semester'), 1);" name="<%= "course[#{course.ccode}]" %>" data-unit="3" value="<%= "#{course.id}" %>" class="first_semester" checked><input type="checkbox" checked disabled /></td>
								</tr>
									<% @counter = @counter+1 %>
									<% end %>
								<% end %>
								<% if !@first_semester_courses.nil? %>
									<% @first_semester_courses.each do|course| %>
								<tr class="reg-dta">
								   <td><%= @counter %></td><td ><%= course.ccode %></td><td ><%= course.ctitle %></td><td >C</td><td><%= course.units %></td><td class=""><input type="checkbox" onclick="validateEnrollment($('.first_semester'), 1);" name="<%= "course[#{course.ccode}]" %>" data-unit="3" value="<%= "#{course.id}" %>" class="first_semester" /></td>
								</tr>
									<% @counter = @counter+1 %>
									<% end %>
								<% end %>


							   
								<tr>
									<td ></td><td></td><td>Total Units</td><td ></td><td id="fs-total-units" >0</td><td></td>
								</tr>
								
							</table>
							<table class="table table-striped">
								<tr>
									<td colspan="6" class="semester" id="semester">SECOND SEMESTER</td><br/><br/>
								</tr>
							
								<tr>
									<th class="sn ">S/N</th><th >Course Code</th><th >Course Title</th><th >Course Status</th><th >Unit</th><th class=""></th>
								</tr>
								<% @counter = 1 %>

								<% if !@sscc.nil? %>
									<% @sscc.each do|course| %>
								<tr>
								   <td class="sn "><%= @counter %></td><td ><%= course.ccode %></td><td ><%= course.ctitle %></td><td >C</td><td ><%= course.units %></td><td class=""><input type="hidden" onclick="validateEnrollment($('.second_semester'), 1);" name="<%= "course[#{course.ccode}]" %>" data-unit="3" value="<%= "#{course.id}" %>" class="second_semester" checked><input type="checkbox" checked disabled /></td>
								</tr>
									<% @counter = @counter + 1 %>
									<% end %>
								<% end %>
								<% if !@second_semester_courses.nil? %>
									<% @second_semester_courses.each do|course| %>
								<tr>
								   <td class="sn "><%= @counter %></td><td ><%= course.ccode %></td><td ><%= course.ctitle %></td><td >C</td><td ><%= course.units %></td><td class=""><input type="checkbox" onclick="validateEnrollment($('.second_semester'), 1);" name="<%= "course[#{course.ccode}]" %>" data-unit="3" value="<%= "#{course.id}" %>" class="second_semester" /></td>
								</tr>
									<% @counter = @counter + 1 %>
									<% end %>
								<% end %>

								<tr>
									<td class="s"></td><td ></td><td>Total Units</td><td ></td><td id="ss-total-units" >0</td><td class=""></td>
								</tr>
							</table>
							</div>
							<div id="summary">
								<div class="sum-head">Registration Summary</div>
							<div class="hea">Selected number of Courses</div>
							<label class="name-tag">First Semester:</label><label id="fs-total-courses" class="value-tag">0</label><br/>
							<label class="name-tag">Second Semester:</label><label id="ss-total-courses" class="value-tag">0</label><br/>
							<label class="name-tag">Total:</label><label id="total-courses" class="value-tag">0</label>
							<div class="hea">Number of Units</div>
							<label class="name-tag">First Semester:</label><label id="first-semester-units">0</label><br/>
							<label class="name-tag">Second Semester:</label><label id="second-semester-units">0</label><br/>
							<label class="name-tag">Total:</label><label id="total-units">0</label><br/>
							</div>
							<div class="button-cont"><input type="submit" name="submit" value="Register" id="register-button"></div>
						</form>
					<% end %>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
    $(document).ready(function(){
        //totalNumberOfUnits($(".first_semester"));
    });
    
    function totalNumberOfUnits(courses, extraUnits){
        totalUnits = 0;
        for (var i = 0; i < courses.length; i++) {
            if (courses[i].checked) {
                totalUnits += parseInt(courses[i].getAttribute("data-unit"));
            }
        }

        return totalUnits;   
    }

     function totalCourseRegistered(courses){
        num = 0;
        for (var i = 0; i < courses.length; i++) {
            if(courses[i].checked){
                num+=1;
            }
        }

        return num;
    }

    function displayTotalUnits(courses, sem){
        if(sem == 1){
            document.getElementById("first-semester-units").innerHTML = totalNumberOfUnits(courses);
            document.getElementById("fs-total-units").innerHTML = totalNumberOfUnits(courses);
            document.getElementById("fs-total-courses").innerHTML = totalCourseRegistered(courses);
        }
        else{
            document.getElementById("second-semester-units").innerHTML = totalNumberOfUnits(courses);
            document.getElementById("ss-total-units").innerHTML = totalNumberOfUnits(courses);
            document.getElementById("ss-total-courses").innerHTML = totalCourseRegistered(courses);
        }
        
        document.getElementById("total-units").innerHTML = totalNumberOfUnits($(".first_semester"))+totalNumberOfUnits($(".second_semester"));
        document.getElementById("total-courses").innerHTML = totalCourseRegistered($(".first_semester"))+totalCourseRegistered($(".second_semester"));
    }

   

    function validateEnrollment(courses, sem, extraUnits=0){
        totalNumberOfUnits(courses, extraUnits);
        displayTotalUnits(courses, sem);
    }
</script>