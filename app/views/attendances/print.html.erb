
	

<div class="myrow">
	<div class="col-12">
	<%= render 'layouts/lecturer_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">

				<label class="att-label">COURSE CODE:</label><label> <%= @course.ccode.upcase %></label><br/>
				<label class="att-label">COURSE TITLE: </label><label><%= @course.ctitle.upcase %></label><br/>
				<label class="att-label">UNITS: </label><label><%= @course.units %> UNITS</label><br/>
				<label class="att-label">LEVEL:</label><label> <%= @course.level %> LEVEL</label><br/><br/>
				<label class="att-label">DATE:</label><label>---------------------------</label><br/><br/>
				
			<table class="table table-bordered">
				<tr>
					<thead>
						<tr>
							<td>S/N</td>
							<td>NAME</td>
							<td>MATRIC. NO</td>
							<td>CA</td>
							<td>EXAM</td>
							<td>TOTAL</td>
							<td>GRADE</td>
							<td>REMARK</td>
							<td>SIGN</td>
						</tr>
					</thead>
					<tbody>
						<% @reg.each do|reg_student| %>
						<tr>
							<td><%= @counter %></td>
							<td><%= reg_student.sname.upcase %>, <%= reg_student.fname.titlecase %> <%= Student.find_by(matno: reg_student.matno).student_othername ? Student.find_by(matno: reg_student.matno).student_othername.othernames : "" %></td>
							<td><%= reg_student.matno.upcase %></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td></td>
						</tr>
						<% @counter+=1 %>
						<% end %>
					</tbody>
				</tr>
			</table>

			<button onclick="print()">Print</button>
					

	        </div>
		</div>
	</div>
</div>

<script>
	$(document).ready(function(){
		$(".adminli").each(function(){
			$(this).removeClass("active-user-menu");
		});
		
		$("#attendance").addClass("active-user-menu");
	});
</script>