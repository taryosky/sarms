<div class="myrow">
	<div class="col-12">
	<%= render 'layouts/lecturer_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">

                <h3 class = "head">Print Attendance</h3>
				<hr/>
                <table id="attendance" class="table table-bordered">
                <th>S/N</th><th>Course Code</th><th>Course Title</th><th>Action</th>
                <% @courses.each do|course| %>
                        <tr>
                            <td><%= @counter %></td>
                            <td><%= course.ccode %></td>
                            <td><%= course.ctitle.titlecase %></td>
                            <td><%= form_for :course, url: print_attendance_path do|f| %>
                                <%= f.hidden_field :course_id, value:"#{course.id}" %>
                                <%= f.submit "Print Attendance" %>
                            <% end %></td>
                        </tr>

                    <% @counter +=1 %>
                <% end %>
                </table>
					

	        </div>
		</div>
	</div>
</div>