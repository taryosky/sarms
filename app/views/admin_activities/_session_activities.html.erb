        <div class="row disp_false">
            <div class="col-d-6 col-md-6 disp_false">
                <div class="panel panel-default">
                    <div class="panel-body easypiechart-panel custom-height">
                        <div class="panel-heading">SESSION</div>
                        <div id="set_session">
                            <input id="input1" type="text" value=<%= @temp[0]%> class="fixed-lenght" style="text-align: right;" /><input id="seperator" type="text" value="/" disabled="true" /><input id="input2" class="fixed-lenght" type="text" value= <%= @temp[1]%> />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-d-6 col-md-6 disp_false">
                <div class="panel panel-default">
                    <div class="panel-body easypiechart-panel">
                        <div class="panel-heading">COURSE REGISTRATION STATUS</div>
                        <div id="reg_stat">
                            <% if @reg_stat==1 %>
                            <input id="1" type="radio" name="reg_stat" checked />ACTIVATE
                            <input id="0" type="radio" name="reg_stat"/>DEACTIVATE
                            <%else%>
                            <input id="1" type="radio" name="reg_stat"/>ACTIVATE
                            <input id="0" type="radio" name="reg_stat" checked/>DEACTIVATE
                            <%end%>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12 col-sm-12 col-xs-12 disp_false">
                <div id="time-table-div" class="panel panel-default">
                    <div class="panel-heading week_days">
                        <div id="monday">mon</div>
                        <div id="tuesday">tue</div>
                        <div id="wednesday">wed</div>
                        <div id="thusday">thu</div>
                        <div id="friday">fri</div>
                    </div>
                    <div class="panel-body">
                        <div id="table_for_courses" class="table-responsive">
                            <table class="table table-bordered">
                                <thead id="time_table_head">
                                    <tr class="custom">
                                        <th></th>
                                        <th>8 : 00am - 10 : 00am</th>
                                        <th>10 : 00am - 12 : 00am</th>
                                        <th>12 : 00pm - 2 : 00pm</th>
                                        <th>2 : 00pm - 4 : 00pm</th>
                                        <th>4 : 00pm - 6 : 00pm</th>
                                    </tr>
                                </thead>
                                <tbody id="courses_body">
                                     <tr class="custom">
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px"></td>
                                    </tr> 
                                    <tr class="custom">
                                        <th rowspan="5">monday</th>
                                        <td><input class = "table_input"></td>
                                        <td><input class = "table_input"></td>
                                        <td><input class = "table_input"></td>
                                        <td><input class = "table_input"></td>
                                        <td><input class = "table_input"></td>
                                    </tr>
                                    <%for i in (0..3)%>
                                        <tr class="custom">
                                            <td><input class = "table_input"></td>
                                            <td><input class = "table_input"></td>
                                            <td><input class = "table_input"></td>
                                            <td><input class = "table_input"></td>
                                            <td><input class = "table_input"></td>
                                        </tr>
                                    <%end%>                              
                                </tbody>
                            </table>

                            <div id="time-table-activs">
                                <div id="tt_view">view</div>
                                <div id="print">print</div>
                            </div>
                        </div>                               
                    </div>
                </div>
            </div>
                <div class="row">
                    <div class="col-md-4 col-sm-12 col-d-12 disp_false">
                    </div>
                    <div class="col-md-4 col-sm-12 col-d-12 disp_false">
                        <div class="panel panel-default" style="text-align: center; min-height: 600px">
                            <div class="panel-heading">
                                Course Allocation
                            </div>
                            <div id = "alloc_tab">
                                <div class="levels">
                                    <div id="100">100</div>
                                    <div id="200">200</div>
                                    <div id="300">300</div>
                                    <div id="400">400</div>
                                    <div id="500">500</div>
                                </div>
                            </div> 
                            <div id = "alloc_contents"> 

                                    <% if !@courses.empty? %>
        <div id="avai_courses" >
            <div id = "add_lect">ADD LECTURER</div>
            <% @courses.each do |c| %>
                <span style="display:inline; margin-right: 12px;"><%= c.ccode %></span><=>
                <select class= 'modal_inputs course_alloc' data-level="<%= c.level%>" data-aloc="<%= c.id %>"  style="margin-bottom: 25px; margin-left: 12px;">
                    <option id="opt_remove">default</option>
                    <% @lecturer.each do |l|%>
                        <option id="<%= l.id%>" class="click"><%="#{l.title} #{l.sname} #{l.fname} "%></option>
                    <% end %>
                </select>
                <br/>
            <% end %>
        </div>
        <div id="remove_lecturer" >
            <div id = "rem_lect">REMOVE LECTURER</div>
            <% error= true%>
            <% @courses.each do |c| %>
                
                <% if @alloc_courses.find_by(course_id: c.id) %>
                <% error= false%>
                    <% lect_id = @alloc_courses.where(course_id: c.id).select(:lecturer_id) %>
                    <span style="display:inline; margin-right: 12px;"><%= c.ccode %></span><=>
                        <select class= 'modal_inputs' data-level="<%= c.level%>" data-aloc="<%= c.id %>"  style="margin-bottom: 25px; margin-left: 12px;">
                            <option id="opt_remove">default                                            
                            </option>
                            <% lect_id.each do |lect| %>
                                <% lecturer= @lecturer.find_by(id: lect.lecturer_id) %>
                                <option class="remove_opt" ><%="#{lecturer.title} #{lecturer.sname} #{lecturer.fname}" %></option>
                            <% end %>
                        </select><br/>                
                <% end %>
            <% end %>
            <%if error%>
                <div id="allo_error">
                    NO lecturer allocated
                </div>
            <%end%>
        </div>

        <div id="course_titles">
            <% @courses.each do |c|%>
                <p><%= "#{c.ccode} #{c.ctitle}"%></p>
            <% end %>
        </div>
        
    <% else %>
        <div id="coures_view_error">
            NO <%=@level%> level course available
        </div>
    <% end %>



                            </div>
                            <div id="time-table-activs">
                                    <div id="ca_view">view</div>
                                    <div id="print">print</div>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="modal">
            </div>