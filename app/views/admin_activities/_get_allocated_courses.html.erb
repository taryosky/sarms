<div id="edit_cont1" class="my-modal" style="display: block;">		
		<div id="edit_modal" class="my-modal-content">
        <div class="my-modal-header">
         <span id="cancel_edit_lect" class="cancel_button" data-class="cancel_ref" data-ref="edit_cont1">×</span>
          <h2>TIME TABLE</h2>
        </div>
        <div id="edit_modal_body" class="my-modal-body">
        <div id="find_course_option" class="course_option" data-class="display">
           <div class="row">
                    <div class="col-t-12 col-d-12">
                            <div id="time_table_bg" class="handle white_bg ttable_pad">
                            	<table class="table table-bordered">
                                <thead id="time_table_head" class="center_data ttable_head">
                                    <tr>
                                        <th>COURSE CODE</th>
                                        <th>COURSE TITLE</th>
                                        <th>LECTURERS</th>
                                    </tr>
                                </thead>
                                <tbody id="courses_body" class="center_data">
                            	<% @courses.each do |c| %>

									<% if course = @alloc_courses.find_by(course_id: c.id) %>
										<tr>
											<td><%="#{c.ccode}" %></td>
											<td><%="#{c.ctitle}" %></td>
											<td>
												<% lect_id = @alloc_courses.where(course_id: c.id).select(:lecturer_id) %>
												<% lect_id.each do |lect| %>
											        <% lecturer= Lecturer.find_by(id: lect.lecturer_id) %>
											        <%="#{lecturer.title} #{lecturer.sname} #{lecturer.fname}" %><br/>
											    <% end %>
											</td>
										</tr>
									<% end %>
								<% end %>
	                         </tbody>
                            </table>
                        </div>
                    </div>
                <div class="col-2"></div>
            </div>
            </div>
        </div>
      </div>
    </div>