function show_courses_for_the_day(){
	$(".week_days > div").click(function(){
		var append_elem = document.getElementsByClassName("custom");
		var div = $(this);

		var str_append = create_time_table(div);
		
		for(var i=append_elem.length-2; i>=1; i--){
			append_elem.item(i).nextElementSibling.remove();
		}

		var append_elem = $("#courses_body").append(str_append);
		set_input_field();
		focus_implementation();
	});
}

function init_time_table(){
	var init_elem = $("div#monday");
	var append_elem = document.getElementsByClassName("custom");
		var str_append = create_time_table(init_elem);
		for(var i=append_elem.length-2; i>=1; i--){
			append_elem.item(i).nextElementSibling.remove();
		}
		var append_elem = $("#courses_body").append(str_append);
		set_input_field();
		focus_implementation();
}

function set_input_field(){
	$(".table_input").each(function(index){
	$(this).attr("maxlength","14");
	});
}

function set_session(input){
	$.ajax({
			headers: {'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')},
			url: '/setsession',
			type: 'POST',
			data: {"input": input},
			error: function(data, status, xhr){
				alert("An error occured in set_session method");
			},
			success: function (data, status, xhr) {}// success callback function
	});
}
// workflag
function create_time_table(div){
	var json_data;
	var ajaxR = get_time_table();
	 ajaxR.done(function(data){
	 	json_data = data;
	 });
	var div_name = div.attr("id");
	var query_name=div_name.substr(0,3);
	var return_string = "";
	var row_count = -1;
	for(var tr=0; tr<5; tr++){
		return_string += "<tr class=\"custom\">";
		row_count+=1;
		var temp;
		if(tr==0){
			return_string += "<th rowspan=\"5\">"+div_name+"</th>";
			for(var td=1; td<=5; td++){
				var temp = json_data[query_name][td][tr];
				
				return_string += "<td><input class=\"table_input\" id="+"\""+ div_name +"_"+td+"_"+row_count+"\""+" value=\""+temp+"\" type=\"text\" /></td>";
			}
		}else{
			for(var td=1; td<=5; td++){
				var temp = json_data[query_name][td][tr].toString();
				
				return_string += "<td><input class=\"table_input\" id="+"\""+ div_name +"_"+td+"_"+row_count+"\""+" value=\""+temp+"\" type=\"text\" /></td>";
			}
		}
		return_string += "</tr>";
	}
	return return_string;
}

function validate_session_field(){
	$("#seperator").attr("disabled","true");
	$("input.fixed-lenght").attr("maxlength","4");
	$("input.fixed-lenght").focusout(function(){
		var elem = $(this);
		var id = elem.attr("id");
		var val = elem.val().trim();
		var val1 = parseInt(val);
		var input1 = $("#input1");
		var input2 = $("#input2");
		if (isNaN(val1)||val1==0){
			input1.val(<%=@temp[0]%>);
			input2.val(<%=@temp[1]%>);
		}else{

			if(id=="input1"){
				input2.val(parseInt(val)+1);
			}else if(id =="input2"){
				input1.val(parseInt(val)-1);
			}else{

			}
			set_session(input1.val());
		}
	});
}

function focus_implementation(){

	var past_val = "";
	var focus = false;
	$(".table_input").focusout(function() {
		focus = true;
		var query = $.trim($(this).val()).toUpperCase();
		$(this).val(query.toUpperCase());

		var element = $(this);
		var elem_id = element.attr("id");
		var day = elem_id.substr(0,3);
		var array = elem_id.split('_');

		var period = array[1];
		var row = array[2];

		checkcode(past_val, query, element, day, period, row);
  	});
	
	$(".table_input").focusin(function() {
		var $elem = $(this);
		var elem_id = $elem.attr("id");
		var array = elem_id.split('_');
		$elem.css("border","0px")
		past_val = $elem.val().trim().toUpperCase();
	});	
}

function set_time_table(element, past_val, value, day, period, row, hall){
	
	$.ajax({
			headers: {'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')},
			url: '/settimetable.json',
			type: 'POST',
			data: {"past_val": past_val, "value": value, "day": day, "period": period, "row":row, "hall":hall},
			error: function(data, status, xhr){
				alert("An error occured in set_time_table method");
			},
			success: function (data, status, xhr) {
				if(data){
					element.val("");
				}
			}// success callback function
	});
}

function get_time_table(){
	return $.ajax({
			headers: {'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')},
			url: '/gettimetable.json',
			async:false,
			type: 'POST'
	});
}

function checkcode(past_val, query, element, day, period, row){
	if(query==""){
		set_time_table(element, past_val, query, day, period, row, "");
		element.css("border","0px");
	}else{
		$.ajax(
				{	
					headers: { 'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')},
					url: '/query_code.json',
					type: 'POST',
					data: {"query" : query, "past_val" : past_val},
					error: function (data, status, xhr){
						alert("An error occured in checkcode method");
					},
		            success: function (data, status, xhr) {// success callback function
		            	if(data['response']){
		                  	element.css("border","0px");
		                  	set_time_table(element, past_val, query, day, period, row, data['hall']);
		                  	element.css("border","0px");
		                  }else{
		                  	element.css("border","1px solid green");
		                  	element.val(data['value']);                 	
		                  }
		            }
	    		}
	    	);
	}
}

