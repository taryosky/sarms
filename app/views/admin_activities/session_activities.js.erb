/*FUNCTION TO REMOVE LECTURER*/
function remove_lect(){
	$(".remove_opt").click(function(){
		var opt_elem = $(this);
		var opt_val = opt_elem.val();
		var parent = opt_elem.parent();
		var course_id = parent.attr("data-aloc");
		var level = parent.attr("data-level");
		opt_elem.hide();

		$.ajax(
				{	
					headers: { 'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')},
					url: '/remove_lect',
					type: 'POST',
					data: {"lect_name" : opt_val, "course_id" : course_id, "level" : level},
					error: function (data, status, xhr){
						alert("An error occured in remove_lect method");
					},
		            success: function (data, status, xhr) {// success callback function
		            	
		            }
	    		}
	    	);
	});
}