                <div class="row">
            <div class="col-d-3 col-md-3">
                <div class="panel panel-default">
                    <div class="panel-body easypiechart-panel">
                        <h4>No. of Visits</h4>
                        <div class="easypiechart" id="easypiechart-blue" data-percent="82"><span style="font-size: 30pt;" class="percent"><%= Util.select("value").where("name = ?", "site_visits").first.value %></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-d-3 col-md-3">
                <div class="panel panel-default">
                    <div class="panel-body easypiechart-panel">
                        <h4>Lecturers</h4>
                        <div class="easypiechart" id="easypiechart-orange" data-percent="55"><span style="font-size: 30pt;" class="percent"><%= Lecturer.all.size %></span></div>
                    </div>
                </div>
            </div>
            <div class="col-d-3 col-md-3">
                <div class="panel panel-default">
                    <div class="panel-body easypiechart-panel">
                        <h4>Students</h4>
                        <div class="easypiechart" id="easypiechart-teal" data-percent="84"><span style="font-size: 30pt;" class="percent"><%= Student.all.size %></span></div>
                    </div>
                </div>
            </div>
            <div class="col-d-3 col-md-3">
                <div class="panel panel-default">
                    <div class="panel-body easypiechart-panel">
                        <h4>Courses</h4>
                        <div class="easypiechart" id="easypiechart-red" data-percent="46"><span style="font-size: 30pt;" class="percent"><%= Course.all.size %></span>
                        </div>
                    </div>
                </div>
            </div>
        </div> 
		
		<div class="row">
			<div class="col-md-4 col-sm-12 col-d-8">
				<div class="panel panel-default">
					<div class="panel-heading">
						Student Statistics
					</div>
					<div class="panel-body">
					
						<div id="stat" class="list-group">
						
							<a href="#" class="list-group-item">
								<span class="badge"><%= Student.all.size %></span>
								 Total Number Of Students
							</a>
							
							<a href="#" class="list-group-item">
								<span class="badge"><%= Student.where("level = ?", "100").size %></span>
								Number Of 100 Level Students
							</a>
							
							<a href="#" class="list-group-item">
								<span class="badge"><%= Student.where("level = ?", "200").size %></span>
								Number Of 200 Level Students
							</a>
							
							<a href="#" class="list-group-item">
								<span class="badge"><%= Student.where("level = ?", "300").size %></span>
								Number Of 300 Level Students
							</a>
							
							<a href="#" class="list-group-item">
								<span class="badge"><%= Student.where("level = ?", "400").size %></span>
								Number Of 400 Level Students
							</a>
							
							<a href="#" class="list-group-item">
								<span class="badge"><%= Student.where("level = ?", "500").size %></span>
								Number Of 500 Level Students
							</a>
							
							<a href="#" class="list-group-item">
								<span class="badge"><%= Student.where("level > ?", "500").size %></span>
								Number Of Spillover Students
							</a>
							
						</div>
						
					</div>
				</div>				
			</div>
			
			<div class="col-md-4 col-sm-12 col-d-4">
				<div class="row">
					<div class="col-md-4 col-sm-12 col-d-12">
						<div class="panel panel-default">
							<div class="panel-heading">
								Courses Information
							</div>
							<div class="panel-body">
								<div class="list-group">

									<a href="#" class="list-group-item">
										<span class="badge"><%= Course.where.not(id: @course_ids).size %></span>
										 Unallocated Courses
									</a>
									<a href="#" class="list-group-item">
										<span class="badge"><%= Lecturer.where.not(id: @lecturer_ids).size %></span>
										Unallocated Lecturers
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
					
				<div class="row">
					<div class="col-md-4 col-sm-12 col-d-12">
						<div class="panel panel-default">
							<div class="panel-heading">
								Session Information
							</div>
							<div class="panel-body">
								<div class="list-group">

									<a href="#" class="list-group-item">
										<span class="badge"><%= Util.where("name = ?", "session").first.value %> </span>
										 Current Session
									</a>
									<a href="#" class="list-group-item">
										<span class="badge"><%= Util.where("name = ?", "registration").first.value.to_i == 1 ? "Open":"Closed" %></span>
										Course Registration Portal
									</a>
								</div>
							</div>
						</div>
					</div>
					
				</div>
			</div>
		</div>
       
		<div class="row">
			<div class="col-md-4 col-sm-12 col-d-12">
			</div>
			<div class="col-md-4 col-sm-12 col-d-12">
				<div class="panel panel-default">
					<div class="panel-heading">
						Tasks Panel
					</div>
					<div class="panel-body">
						<div class="list-group">

							<a href="#" class="list-group-item">
								<span class="badge"><%= time_ago_in_words(@time_signin).titlecase + " ago" %></span>
								<i class="fa fa-fw fa-comment"></i> <%= @title_signin %>
							</a>
							<a href="#" class="list-group-item">
								<span class="badge"><%= time_ago_in_words(@time_create).titlecase + " ago" %></span>
								<i class="fa fa-fw fa-truck"></i> <%= @title_create %>
							</a>
							<a href="#" class="list-group-item">
								<span class="badge">36 minutes ago</span>
								<i class="fa fa-fw fa-globe"></i> New Student created
							</a>
						</div>
						<div class="text-right">
							<a href="#">More Tasks <i class="fa fa-arrow-circle-right"></i></a>
						</div>
					</div>
				</div>
			</div>
		</div>
                <!-- /. ROW  -->        
                <footer>

                </footer>
            </div>
        </div>