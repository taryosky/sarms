
<div class="myrow">
	<div class="col-12">
	<%= render 'layouts/student_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">
				<h3 class="dashboard-header">Notifications
					<% if flash[:success] %>
						<span class="success-message s-me"><%= flash[:success] %></span>
					<% end %>
					<% if flash[:error] %>
						<span class="error-message e-me"><%= flash[:error] %></span>
					<% end %>
				</h3>
				<hr/>
				<% if @notifications.empty? %>
					<h3 class="centered empty-q">You have no notifications</h3>
				<% else %>
					<% @notifications.each do|key, note| %>
						<% if key == "assign" %>
							<div class="alert alert-success">
							  <strong>Assignment(s): &nbsp</strong> You have <%= note %> unsubmitted assignment(s). click <%= link_to "here", assignment_submissions_path %> to submit
							</div>
						<% end %>
						
						<% if key == "message" %>
							<div class="alert alert-success">
							  <strong>Message(s): &nbsp</strong> You have <%= note %> unread message(s). click <%= link_to "here", inbox_path %> to view
							</div>
						<% end %>
					<% end %>
				<% end %>
	        </div>
		</div>
	</div>
</div>

<script>
	$(document).ready(function(){
		$(".adminli").each(function(){
			$(this).removeClass("active-user-menu");
		});
		
		$("#dash").addClass("active-user-menu");
	});
</script>