<div class="myrow">
	<style>
	 .table>tbody>tr>td, .table>tbody>tr>th, .table>tfoot>tr>td, .table>tfoot>tr>th, .table>thead>tr>td, .table>thead>tr>th {border:none;}
	</style>
	<div class="col-12">
	<%= render 'layouts/lecturer_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">
			
			
			
			<h3 class="dashboad-header">Submit Results
					<% if flash[:success] %>
						<span class="success-message s-me"><%= flash[:success] %>
					<% end %>
					<% if flash[:error] %>
						<span class="error-message e-me"><%= flash[:error] %>
					<% end %>
				</h3><hr/>

					
					<% if @courses.empty? %>
						<h3 class="empty-q"> Sorry You were not assigned any course for the session </h3>
					<% else %>
							<p> Select course to enter Results for this session </p>
							<% if flash[:success] %>
								<div class="success"><%= flash[:success] %></div>
							<% end %>
							 <% if flash[:success] %>
								<div class="success"><%= flash[:error] %></div>
							  <% end %>
								<div class="table-responsive">
									<table id="submission" class="table table-striped table-hover">
									<th>S/N</th><th>Course Code</th><th>Course Title</th><th>Action</>

									<% @courses.each do|course| %>
										<% if submited_before?(course) %>
											<tr>
												<td><%= @counter %></td>
												<td><%= course.ccode %></td>
												<td><%= course.ctitle.titlecase %></td>
												<td><%= form_for :course, url: edit_scores_path do|f| %>
													<%= f.hidden_field :course_id, value:"#{course.id}" %>
													<%= f.submit "Edit Result", class:"login-button", style:"margin:0px" %>
												<% end %></td>
											</tr>
										<% else %>
											<tr>
												<td><%= @counter %></td>
												<td><%= course.ccode %></td>
												<td><%= course.ctitle.titlecase %></td>
												<td><%= form_for :course, url:scores_path do|f| %>
													<%= f.hidden_field :course_id, value:"#{course.id}" %>
													<%= f.submit "Submit Result", class:"login-button", style:"margin:0px" %>
												<% end %></td>
											</tr>
										<% end %>
										<% @counter +=1 %>
									<% end %>

									</table>
								</div>
				   <% end %>
					
					

	        </div>
		</div>
	</div>
</div>