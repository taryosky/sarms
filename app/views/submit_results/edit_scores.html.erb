<div class="myrow">
	<div class="col-12">
	<%= render 'layouts/lecturer_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">
			
			
			
			<h3 class="dashboad-header">Edit Results Scores
					<% if flash[:success] %>
						<span class="success-message s-me"><%= flash[:success] %>
					<% end %>
					<% if flash[:error] %>
						<span class="error-message e-me"><%= flash[:error] %>
					<% end %>
				</h3><hr />

				<label class="info-label">Course Code:</label><label> <%= @course.ccode %></label><br/>
				<label class="info-label">Course Title:</label><label><%= @course.ctitle %></label><br/>
				<label class="info-label">Units:</label><label><%= @course.units %> </label><br/><br/>
				<%= form_for :scores, url: edit_all_scores_path do|f| %>
				<%= f.hidden_field :course, value: @course.id %>
				<div class="table-responsive">
					<table id="scores_table" class="table table-bordered table-striped table-hover">
						<tr>
							<th>S/N</th><th>Matric. No.</th><th>C. A. Score</th><th>Exam Score</th>
						</tr>

							<% @stud_info.each do|stud_info| %>
								<tr>
									<td><%= @counter %></td>
									<td><%= f.label "#{stud_info.matno}" %></td>
									<%= fields_for :ca_score do|fe| %>
									  <td> <%= fe.text_field "#{stud_info.matno}", value: "#{stud_info.C_A_score}", class:"score-field" %></td>
									<% end %>
									<%= fields_for :exam_score do|fe| %>
									   <td><%= fe.text_field "#{stud_info.matno}", value: "#{stud_info.exam_score}", class:"score-field" %></td>
									<% end %>
								   <% @counter = @counter+1 %>
							   </tr>
							<% end %>
					</table>
				</table>
				<%= f.submit :Finish, class:"login-button", style:"margin:0px" %>
				 <% end %>
				
				
				
	        </div>
		</div>
	</div>
</div>

				