<h1>HELLO WORLD</h1>
<div id="create_course" class="my-modal" style="display: block;">
    <div id="create_modal" class="my-modal-content">
        <div class="my-modal-header">
          <span id="cancel_create_course" class="close cancel_button" data-class="cancel_ref" data-ref="create_cont">×</span>
          <h2>CREATE NEW COURSE</h2>
        </div>
        <div id="create_modal_body" class="my-modal-body">
            <div id="create_course_option" class="course_option" data-class="display">
                <div class="myrow">
                    <div class="col-t-12 col-d-12 no-padding">
                        <div class="handle white_bg">
                            <% if flash[:success] %>
                                <div class = 'success'><%= flash[:success] %></div>
                            <% end %>
                            <% if flash[:error] %>
                                <div data-class="notice" class = 'error'></div>
                            <% end %>
                            <%= form_for :create_course,  url:create_course_path, remote: true,  html: {id: "create_form"} do|f| %>
                                <table>
                                    <div id="course-fields0" class="fields_div">
                                    <span id="new-course-error0" class ='error'></span>
                                    </div>
                                    <tr>
                                        <th>CODE</th>
                                        <th>TITLE</th>
                                        <th>UNITS</th>
                                        <th>LEVEL</th>
                                        <th>STATUS</th>
                                        <th>SEMESTER</th>
                                    </tr>
                                    <%i=0%>
                                    <% CSV.foreach(@file_path) do |row| %>
                                        <% ccode, ctitle, units, level, status, semester = row %>
                                        <span id="new-course-error0" class ='error'></span>
                                        <tr>
                                            <td><%= fields_for :code do|fc| %>
                                                <%= fc.text_field "ccode#{i}",  id: 'create_ccode_field', class: 'modal_inputs', value: ccode %>
                                                <% end %>
                                            </td>
                                            <td><%= fields_for :title do|ft| %>
                                                <%= ft.text_field "ctitle#{i}", id: 'create_ctitle_field', class: 'modal_inputs', value: ctitle %>
                                                <% end %>
                                            </td>
                                            <td><%= fields_for :units do|fu| %>
                                                <%= fu.text_field "units#{i}", id: 'create_units_field', class: 'modal_inputs', value: units %>
                                                <% end %>
                                            </td>
                                            <td><%= fields_for :level do|fl| %>
                                                <%= fl.text_field "level#{i}", id: 'create_level_field', class: 'modal_inputs', value: level %>
                                                <% end %>
                                            </td>
                                            <td><%= fields_for :status do|fs| %>
                                                <%= fs.text_field "status#{i}", id: 'create_status_field', class: 'modal_inputs', value: status %>
                                                <% end %>
                                            </td>
                                            <td><%= fields_for :semester do|fs| %>
                                                <%= fs.text_field "semester#{i}", id: 'create_semester_field', class: 'modal_inputs', value: semester %>
                                                <% end %>
                                            </td>
                                        </tr>
                                        <% i+=1 %>
                                    <% end %>
                                </table>
                                <%= f.submit :create, id: 'create_course', class:"admin-cont-btn" %>
                            <% end %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>