<div class="myrow">
	<div class="col-12">
	<%= render 'layouts/student_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">
			
			
			             <h3 class="dashboad-header">Profile Completion
					<% if flash[:success] %>
						<span class="success-message s-me"><%= flash[:success] %>
					<% end %>
					<% if flash[:error] %>
						<span class="error-message e-me"><%= flash[:error] %>
					<% end %>
				</h3><hr style="margin-bottom: 0px"/>
                <div  class="">
                <% if @activation == 0 %>
					<div class="myrow"  style="text-align: left">
						<div class="col-t-1 col-d-1"></div>
						<div class="col-t-10 col-d-10">
							<div class="notice">Welcome, First, You Need To Update Your Profile Data.</div>
							<div class="error-msg">
								<% if @student.errors.any? %>
									<% @student.errors.full_messages.each do|error| %>
										<div> <%= error %> </div>
									<% end %>
								<% end %>
							</div>
							<%= form_for :edit_student, url: student_info_update_path do|f| %>
								<fieldset>
								<%= f.label "Matric. No:", class:"info-label" %>
								<%= f.text_field :matno, value: "#{current_student.matno}", class: "info-field", id: "info-matno-field", disabled:true %><br/>
								
								<%= f.label "Surname:", class:"info-label" %>
								<%= f.text_field :sname, value: "#{current_student.sname}", class: "info-field", id: "info-sname-field" %><br/>
								
								<%= f.label "First Name:", class:"info-label" %>
								<%= f.text_field :fname, value: "#{current_student.fname}", class: "info-field", id: "info-fname-field" %><br/>
								
								<%= f.label "Other Names:", class:"info-label" %>
								<%= f.text_field :othernames, value: "#{current_student.student_othername.othernames if current_student.student_othername}", class: "info-field", id: "info-oname-field" %><br/>
								
								<%= f.label "Sex:", class:"info-label" %><%= f.label :male, class:"info-radio-label" %><%= f.radio_button :sex, :male, class:"info-radio-button", checked:true %><span id="button-separate"></span><%= f.label :female, class:"info-radio-label" %><%= f.radio_button :sex, :female, class:"info-radio-button" %><br/>
								
								<%= f.label "Nationality:", class:"info-label" %>
								<%= f.text_field :nationality, class: "info-field", id: "info-nationality-field" %><br/>
								
								<%= f.label "State Of Origin:", class:"info-label" %>
								<%= f.text_field :state_of_origin, class: "info-field", id: "info-soo-field" %><br/>
								
								<%= f.label "L.G.A:", class:"info-label" %>
								<%= f.text_field :lga, class: "info-field", id: "info-lga-field" %><br/>
								
								<%= f.label "Religion:", class:"info-label" %>
								<%= f.text_field :religion, class: "info-field", id: "info-religion-field" %><br/>
								
								<%= f.label "Email:", class:"info-label" %>
								<%= f.email_field :email, class: "info-field", id: "info-email-field" %><br/>
								
								<%= f.label "Phone:", class:"info-label" %>
								<%= f.text_field :phone, class: "info-field", id: "info-phone-field" %><br/>
								
								<%= f.submit :update, class:'login-button', id:"student-update-button-1" %>
								</fieldset>
							<% end %>
						</div>
						<div class="col-t-1 col-d-1"></div>
					</div>
				<% elsif @activation == 1 %>
					<div class="myrow">
						<div class="col-t-1 col-d-1"></div>
						<div class="col-t-10 col-d-10">
							<div class="notice">Upload Your Passport, click on upload button to select a file</div>
							<div class="error-msg">
								<% if @student.errors.any? %>
									<% @student.errors.full_messages.each do|error| %>
										<div> <%= error %> </div>
									<% end %>
								<% end %>
							</div>
							<%= form_for :student_passport, url: student_info_update_path, multipart:true do|f| %>
								<%= image_tag current_student.sex == "male" ? "male.png":"female.png", id:"stud-passport" %>

								<%= f.file_field :passport, class: "info-field", id: "info-pass-field" %><br/>
								
								<%= f.submit :Upload, class:'login-button', id:"student-update-button" %>
							<% end %>
						</div>
						<div class="col-t-1 col-d-1"></div>
					</div>
				<% else %>
					<div class="myrow">
						<div class="col-t-1 col-d-1"></div>
						<div class="col-t-10 col-d-10">
							You Need to change your Password
							<div class="error-msg">
								<% if @student.errors.any? %>
									<% @student.errors.full_messages.each do|error| %>
										<div> <%= error %> </div>
									<% end %>
								<% end %>
							</div>
							<%= form_for :student_password, url: student_info_update_path, multipart:true do|f| %>
								<%= f.label "Password:", class:"info-label" %>
								<%= f.password_field :password, class: "info-field", id: "info-password-field" %><br/>
								
								<%= f.label "Confirm Password:", class:"info-label" %>
								<%= f.password_field :password_c, class: "info-field", id: "info-password-field" %><br/>
								
								<%= f.submit :Save, class:'login-button', id:"student-update-button-1" %>
							<% end %>
						</div>
						<div class="col-t-1 col-d-1"></div>
					</div>
				<% end %>
				
				
				
	        </div>
		</div>
	</div>
</div>

				