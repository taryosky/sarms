<div class="myrow">
	<div class="col-12">
	<%= render 'layouts/student_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">
				<h3 class="dashboard-header">TimeTable<br/>
						<table class="table table-bordered">
                                <thead id="stu_time_table_head">
                                    <tr class="custom">
                                        <th></th>
                                        <th>8 : 00am - 10 : 00am</th>
                                        <th>10 : 00am - 12 : 00am</th>
                                        <th>12 : 00pm - 2 : 00pm</th>
                                        <th>2 : 00pm - 4 : 00pm</th>
                                        <th>4 : 00pm - 6 : 00pm</th>
                                    </tr>
                                </thead>
                                <tbody id="stu_courses_body">
                                    <tr class="custom">
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px"></td>
                                        <td style="border: 0px"></td>
                                    </tr>
                                    <tr class="custom">
                                        <th>monday</th>
                                        <% @mon.each do |mon|%>
                                        	<td><%=mon%></td>
                                        <% end %>
                                    </tr>
                                    <tr class="custom">
                                        <th>tuesday</th>
                                        <% @tue.each do |tue|%>
                                        	<td><%=tue%></td>
                                        <% end %>
                                    </tr>
                                    <tr class="custom">
                                        <th>wednesday</th>
                                        <% @wed.each do |wed|%>
                                        	<td><%=wed%></td>
                                        <% end %>
                                    </tr>
                                    <tr class="custom">
                                        <th>thusday</th>
                                        <% @thu.each do |thu|%>
                                        	<td><%=thu%></td>
                                        <% end %>
                                    </tr>
                                    <tr class="custom">
                                        <th>friday</th>
                                        <% @fri.each do |fri|%>
                                        	<td><%=fri%></td>
                                        <% end %>
                                    </tr>    
                                </tbody>
                            </table>
	        </div>
		</div>
	</div>
</div>