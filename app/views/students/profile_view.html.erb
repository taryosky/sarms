
<div class="myrow">
	<div class="col-12">
	<%= render 'layouts/student_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">
				<h3 class="dashboard-header">Student Profile
					<% if flash[:success] %>
						<span class="success-message s-me"><%= flash[:success] %></span>
					<% end %>
					<% if flash[:error] %>
						<span class="error-message e-me"><%= flash[:error] %></span>
					<% end %>
				</h3><hr style="margin-bottom: 0px"/>
                <div  class="myrow">
					<div class="col-d-6">
							<%= form_for :edit_student, url: student_info_update_path do|f| %>
								<fieldset>
								<%= f.label "Matric. No:", class:"info-label" %>
								<%= f.text_field :matno, value: "#{current_student.matno}".upcase,  id: "info-matno-field", readonly:true %><br/>
								
								<%= f.label "Surname:", class:"info-label" %>
								<%= f.text_field :sname, value: "#{current_student.sname}",  id: "info-sname-field", readonly:true %><br/>
								
								<%= f.label "First Name:", class:"info-label" %>
								<%= f.text_field :fname, value: "#{current_student.fname}",  id: "info-fname-field", readonly:true %><br/>
								
								<% if current_student.student_othername %>
									<%= f.label "Other Names:", class:"info-label" %>
									<%= f.text_field :othernames, value: "#{current_student.student_othername.othernames if current_student.student_othername}",  id: "info-oname-field", readonly:true %><br/>
								<% end %>
								
								<%= f.label "Sex:", class:"info-label" %>
								<%= f.text_field :sname, value: "#{current_student.sex}".titlecase,  id: "info-sex-field", readonly:true %><br/>
								
								<%= f.label "Nationality:", class:"info-label" %>
								<%= f.text_field :nationality, value: "#{current_student.nationality}".titlecase,  id: "info-nationality-field", readonly:true %><br/>
								
								<%= f.label "State Of Origin:", class:"info-label" %>
								<%= f.text_field :state_of_origin, value: "#{current_student.state_of_origin}".titlecase,  id: "info-soo-field", readonly:true %><br/>
								
								<%= f.label "L.G.A:", class:"info-label" %>
								<%= f.text_field :lga,value: "#{current_student.lga}".titlecase,  id: "info-lga-field", readonly:true %><br/>
								
								<%= f.label "Religion:", class:"info-label" %>
								<%= f.text_field :religion, value: "#{current_student.religion}".titlecase,  id: "info-religion-field", readonly:true %><br/>
								
								<%= f.label "Email:", class:"info-label" %>
								<%= f.email_field :email, value: "#{current_student.email}".titlecase,  id: "info-email-field", readonly:true %><br/>
								
								<%= f.label "Phone:", class:"info-label" %>
								<%= f.text_field :phone, value: "#{current_student.phone}".titlecase,  id: "info-phone-field", readonly:true %><br/>
								
								<%= f.label "Password:", class:"info-label" %>
								<%= f.password_field :password, value: "password field".titlecase,  id: "info-phone-field", readonly:true %><button id="change_pass" class="login-button" style="margin:15px 0px 0px 0px;">Change Password</button> <br/>
								
								</fieldset>
							<% end %>
					</div>
					<div class="col-d-5">
						<%= image_tag "profile_images/#{current_student.passport}", id:"stud-passport" %>
						<div>Current Passport </div>
					</div>
					<div>
						<%= form_for :student_passport, url: change_passport_path, multipart:true do|f| %>
							
							<%= f.file_field :passport, class: "info-field", id: "info-pass-field" %><br/>
							
							<%= f.submit "Change Passport", class:'login-button', id:"student-update-button", style:"margin-top:0px" %>
						<% end %>
					</div>				
				
		
	        </div>
			
			<div class="myrow">
					<div class="col-t-4 col-d-4">
						<%= (link_to :Finish, student_notifications_path, class:'login-button', id:"student-updae-button-1", style:"width: 100%;display: inline-block;text-align: center;") if flash[:successful] %>
					</div>
				</div>
		</div>
	</div>
</div>

<div id="pass-modal" class="my-modal">
	<div id="myrow myfade">
		<div class="col-d-3"></div>
		<div class="col-d-6 zoom-in mod-cont">
			<div>
			<h3>Change Password <span id="close-pass-change" style="float:right">&times</span></h3>
			</div>
			<hr style="margin-bottom: 0px; clear:both">
			<div id="modal">
				<%= form_for :student_password, url: student_update_password_path, multipart:true do|f| %>
					<span id="opassword-error e-me" class="password-error"></span>
					<%= f.label "Old Password:", class:"info-label" %>
					<%= f.password_field :opassword, class: "info-field-p", id: "info-opassword-field" %><br/>
					<hr/>
					<span id="password-error" class="password-error e-me"></span>
					<%= f.label "New Password:", class:"info-label" %>
					<%= f.password_field :password, class: "info-field-p", id: "info-npassword-field" %><br/>
					
					<%= f.label "Confirm Password:", class:"info-label" %>
					<%= f.password_field :password_c, class: "info-field-p", id: "info-cpassword-field" %><br/>
					<span id="p-dn-match" class="password_c-error e-me"></span>
					<span id="p-match" class="password_c-success s-me"></span>

					<%= f.submit "Change", class:'login-button', id:"student-update-button-1", style:"margin-left:32%; margin-buttom: 0px;"%>
				<% end %>
			</div>
		</div>
		<div class="col-d-3"></div>
	<div>
</div>

<style>
	input{
		border: none;
		height: 25px;
		margin-left: 20px;
	}
</style>