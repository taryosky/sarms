<div class="myrow">
	<div class="col-t-12 col-d-12">
		<% if @passwords.empty? %>
			<h3>All students are active </h3>
			<% else %>
				<table class="table table-bordered">
				<% @passwords.each do|pass| %>
					<% if @row == 0 %>
						<tr>
					<% end %>
					<% if @col != 2 %>
						<td>
					<% end %>
					<% student = Student.find_by(id: pass.user_id) %>
					<label class = "student_pass_name info-label console">Student Name: </label><label class="console student_name"><%= "#{student.sname.titlecase} #{student.fname.titlecase} #{student.student_othername.othernames if student.student_othername}" %></label></br>
					<label class = "student_pass_uname info-label console">User Name: </label><label class="console student_uname"><%= "#{student.matno.upcase}" %></label></br>
					<label class = "student_pass_pass info-label console">Password: </label><label class="console p-password"><%= "#{pass.password}" %></label></br>			
					<% if @col != 2 %>
						</td>
						<% @col +=1 %>
						<% @row = 1 %>
						<% if @col == 2 %>
							<% @row = 0; @col=0; %>
						<% end %>
					<% end %>
					
					<% if @row == 0 %>
						</tr>
					<% end %>
				<% end %>
				</table>
				
				<button id="print_button" class="button login-button print-hide">Print</button>
		<% end %>
	<div>
</div>
<script>
	$("#print_button").click(function(){
		print();
	});
</script>