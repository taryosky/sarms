<div class = "myrow" >
	<div class="col-12 custom-pad">
	<%= render 'layouts/student_layout/card' %>
	<div class="col-d-9 dash-pane">
	<div id="page-inner" class="myfade">
		<div class="myrow">
            
                <div class="panel panel-default">
                    <div class="panel-body easypiechart-panel">
                    	<% if !flash[:notice].nil?%>
	    		<h4><%=flash[:notice]%></h4>
	    	<% end %>
	    	<% if @ass_code.empty? %>
	    	<h2 class="header">No Pending Assignments</h2>
	    	
	    	<% else %>
	        <h2 class="header">Pending Assignments</h2>
	        <div  class="notification">
	            <% @ass_code.each do |e| %>
					<%= form_for :assign, url: assignment_submit_path do |f| %>
						<%= f.hidden_field :assignment_id, value: e.id %>
						<%= e.course.ccode.upcase %>   <%= e.course.ctitle.titlecase %>   <%= f.submit "submit" %>
					<% end %>
				<% end %>
				</div>
			<% end %>
                    </div>
                </div>
            
        </div>
    </div>

</div>
</div>
</div>