<div class="myrow">
	<div class="col-12">
	<%= render 'layouts/student_layout/card' %>
		<div class="col-d-9">
	        <div class="dashboard">
				<h3 class="dashboard-header">Check Results</h3>
				<hr/>

	           <% if @ass_code.empty? %>
                <h3 class="header empty-q">No Pending Assignments</h3>
            <% else %>
                <h2 class="header">Pending Assignments</h2>
                <div  class="notification">
                    <% @ass_code.each do |e| %>
                        <%= form_for :assign, url: assignment_getassignment_path do |f| %>
                            <%= f.hidden_field :assignment_id, value: e.id %>
                            <%= e.course.ccode.upcase %>   <%= e.course.ctitle.titlecase %>   <%= submit_tag "getAssignment" %>
                        <% end %>
                    <% end %>
                    </div>
            <% end %>
	        </div>
		</div>
	</div>
</div>

<script>
	$(document).ready(function(){
		$(".adminli").each(function(){
			$(this).removeClass("active-user-menu");
		});
		
		$("#ass-sub").addClass("active-user-menu");
	});
</script>